{
  "experiment": "sec_independent_fundamental_discovery_v1",
  "start_decision": "2023-01-01",
  "families": {
    "profitability": {
      "positive": ["operating_margin", "net_margin", "operating_cash_flow_margin", "free_cash_flow_margin"],
      "minimum_features": 2
    },
    "balance_sheet_quality": {
      "positive": ["cash_to_assets", "equity_to_assets"],
      "negative": ["debt_to_assets", "liabilities_to_assets"],
      "minimum_features": 2
    },
    "shareholder_discipline": {
      "positive": ["repurchases_to_revenue"],
      "negative": ["diluted_shares__yoy_growth", "stock_compensation_to_revenue"],
      "minimum_features": 1
    },
    "cash_conversion": {
      "positive": ["operating_cash_flow_margin", "free_cash_flow_margin", "cash_conversion_spread"],
      "minimum_features": 2
    },
    "quality_acceleration": {
      "positive": ["operating_margin_change", "operating_cash_flow_margin_change", "free_cash_flow_margin_change", "equity_to_assets_change"],
      "negative": ["debt_to_assets_change", "diluted_shares__yoy_growth"],
      "minimum_features": 2
    }
  },
  "minimum_companies_per_decision": 20,
  "top_n": 10,
  "sector_neutral_ranking": true,
  "rebalance_rule": "first Friday strictly after each quarterly SEC membership decision",
  "cost_bps": [50, 100, 200],
  "primary_cost_bps": 50,
  "benchmarks": ["SPY", "XLK", "XLE"],
  "missing_company_base": "cash",
  "missing_company_adverse_return": -1.0,
  "valuation_excluded_reason": "Historical split-adjusted prices and filing-date share counts do not form a reliable point-in-time market capitalization without corporate-action normalization.",
  "research_only": true,
  "live_trading_enabled": false
